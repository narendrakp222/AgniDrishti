# Generated datasets
# Commit compact demo datasets so the hosted prototype works immediately.
data/processed/*
!data/processed/.gitkeep
!data/processed/*.csv

# Large raw downloads
# Keep small GeoJSON fixtures, but do not commit multi-hundred-MB downloads.
data/raw/*.json

# Commit the generated demo map used by the dashboard.
!templates/hotspot_map.html
